GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-flash-latest

# Outlook integration (Phase 7) - optional, app runs fine without these
MS_CLIENT_ID=your_azure_app_client_id
MS_CLIENT_SECRET=your_azure_app_client_secret
MS_REDIRECT_URI=http://localhost:5050/auth/callback

# Random secret used to sign the login session cookie - any long random string works
FLASK_SECRET_KEY=your_random_secret_here
